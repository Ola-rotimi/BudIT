{
  "expo": {
    "name": "BudIT",
    "slug": "budit",
    "scheme": "budit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c42bbe4e-3800-4c78-bf05-b162a59baf2f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budit.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "com.budit.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow BudIT to use Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BudIT to use Face ID to unlock the app."
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F0FDFA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#08110F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E",
          "enableRemoteNotifications": false
        }
      ],
      "expo-localization",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "SafeToSpend",
              "displayName": "Safe to spend",
              "description": "How much you can spend each day until payday",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c42bbe4e-3800-4c78-bf05-b162a59baf2f",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.budit.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.budit.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "ola-rotimi"
  }
}
